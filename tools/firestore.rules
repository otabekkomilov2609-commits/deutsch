rules_version = '2';

// streber.uz — Firestore qoidalari (2026-10-23, + a/ va gs/ — chuqur tahlil)
// Tamoyil: o'chirish yo'q · faqat ruxsat etilgan maydonlar · o'lcham/tip tekshiruvi · ID formati tekshiruvi.
service cloud.firestore {
  match /databases/{database}/documents {

    function isHex(s, n) { return s is string && s.size() == n && s.matches('^[a-f0-9]+$'); }
    function str(v, n) { return v is string && v.size() <= n; }
    function int0(v, n) { return v is int && v >= 0 && v <= n; }

    // p: o'quvchining to'liq natijalari (shifrlangan). ID = ism+paroldan hosil qilingan 64 belgili maxfiy kalit.
    match /p/{id} {
      allow get: if isHex(id, 64);
      allow create, update: if isHex(id, 64)
        && request.resource.data.keys().hasOnly(['d', 't'])
        && str(request.resource.data.d, 900000)
        && request.resource.data.t is int;
    }

    // s: qisqa natija — ustoz paneli (shifrlangan e) + ommaviy reyting maydonlari.
    match /s/{id} {
      allow get, list: if true;
      allow create, update: if isHex(id, 64)
        && request.resource.data.keys().hasOnly(['e','t','rk','nm','n','lv','app','gw','gp','pw','pp','hp','hb','pid','g','nw','mr','rc'])
        && str(request.resource.data.e, 30000)
        && request.resource.data.t is int
        && (!('rk' in request.resource.data) || str(request.resource.data.rk, 80))
        && (!('nm' in request.resource.data) || str(request.resource.data.nm, 40))
        && (!('n'  in request.resource.data) || int0(request.resource.data.n, 20000))
        && (!('lv' in request.resource.data) || str(request.resource.data.lv, 12))
        && (!('app' in request.resource.data) || int0(request.resource.data.app, 1))
        && (!('gw' in request.resource.data) || str(request.resource.data.gw, 12))
        && (!('gp' in request.resource.data) || int0(request.resource.data.gp, 200000))
        && (!('pw' in request.resource.data) || str(request.resource.data.pw, 12))
        && (!('pp' in request.resource.data) || int0(request.resource.data.pp, 200000))
        && (!('hp' in request.resource.data) || int0(request.resource.data.hp, 100000))
        && (!('hb' in request.resource.data) || str(request.resource.data.hb, 200))
        && (!('pid' in request.resource.data) || str(request.resource.data.pid, 16))
        && (!('g' in request.resource.data) || str(request.resource.data.g, 12))
        && (!('nw' in request.resource.data) || int0(request.resource.data.nw, 20000))
        && (!('mr' in request.resource.data) || str(request.resource.data.mr, 400))
        && (!('rc' in request.resource.data) || str(request.resource.data.rc, 8));
    }

    // n: shu ism ro'yxatdan o'tganini bildiradi (faqat yaratish).
    match /n/{id} {
      allow get, list: if true;
      allow create: if isHex(id, 64)
        && request.resource.data.keys().hasOnly(['t'])
        && request.resource.data.t is int;
    }

    // ref: do'st linki — kim kimni chaqirgan. ID = <8 hex kod>_<16 hex>.
    match /ref/{id} {
      allow get, list: if true;
      // ID = <6 belgili kod yoki eski 8-hex>_<16 hex: ism-id yoki qurilma-id>. k: r = ro'yxat, v = link ochildi, a = ilova o'rnatdi (2026-10-23)
      allow create, update: if id.matches('^[A-Za-z0-9]{6,8}_[a-f0-9]{16}$')
        && request.resource.data.keys().hasOnly(['by','nm','w','gr','t','k'])
        && str(request.resource.data.by, 8) && request.resource.data.by.size() >= 6
        && str(request.resource.data.nm, 40)
        && int0(request.resource.data.w, 50000)
        && request.resource.data.t is int
        && (!('k' in request.resource.data) || str(request.resource.data.k, 2))
        && (!('gr' in request.resource.data) || int0(request.resource.data.gr, 500))
        && (request.method == 'create' || request.resource.data.by == resource.data.by);
    }

    // mr: 📣 marafon — cfg (chetlatilganlar x, g'oliblar w), top (top-3, har kim yozadi), claim_<pid> (mukofot so'rovi). (2026-10-23)
    match /mr/{id} {
      allow get, list: if true;
      allow create, update: if (id == 'cfg'
          && request.resource.data.keys().hasOnly(['x','w','t'])
          && str(request.resource.data.x, 4000) && str(request.resource.data.w, 3000)
          && request.resource.data.t is int)
        || (id == 'top'
          && request.resource.data.keys().hasOnly(['l','t'])
          && str(request.resource.data.l, 600) && request.resource.data.t is int)
        || (id.matches('^claim_[a-f0-9]{16}$')
          && request.resource.data.keys().hasOnly(['c','t'])
          && str(request.resource.data.c, 160) && request.resource.data.t is int);
    }

    // g: guruh — nomi, a'zolar [[pid,ism]...], egasi (pid). ID = 12 hex. (2026-10-23)
    match /g/{id} {
      allow get, list: if true;
      allow create, update: if isHex(id, 12)
        && request.resource.data.keys().hasOnly(['nm','m','o','t'])
        && str(request.resource.data.nm, 40)
        && str(request.resource.data.m, 4000)
        && str(request.resource.data.o, 16)
        && request.resource.data.t is int;
    }

    // ib: xabarlar qutisi (chaqiruvlar) — pid bo'yicha. (2026-10-23)
    match /ib/{id} {
      allow get: if isHex(id, 16);
      allow create, update: if isHex(id, 16)
        && request.resource.data.keys().hasOnly(['l','t'])
        && str(request.resource.data.l, 20000)
        && request.resource.data.t is int;
    }

    // a: 🔬 chuqur tahlil — o'quvchining shifrlangan batafsil ma'lumoti (faqat ustoz ocha oladi). ID = s/ bilan bir xil. (2026-10-23)
    match /a/{id} {
      allow get, list: if true;
      allow create, update: if isHex(id, 64)
        && request.resource.data.keys().hasOnly(['e','t'])
        && str(request.resource.data.e, 150000)
        && request.resource.data.t is int;
    }

    // gs: 🌐 mehmon va manba hisoblagichlari — ismsiz, kunlik (ID = 2026-10-23). Faqat +1…+5 qo'shish mumkin. (2026-10-23)
    function okInc(k) {
      return !(k in request.resource.data)
        || (request.resource.data[k] is int
            && request.resource.data[k] >= 0
            && request.resource.data[k] <= (resource == null ? 0 : resource.data.get(k, 0)) + 5);
    }
    match /gs/{id} {
      allow get, list: if true;
      allow create, update: if id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['v','nd','rg','f1','w10','r1','r7','nd_ref','nd_brag','nd_du','nd_lnk','nd_ig','nd_tg','nd_web','nd_dir','rg_ref','rg_brag','rg_du','rg_lnk','rg_ig','rg_tg','rg_web','rg_dir','f1_ref','f1_brag','f1_du','f1_lnk','f1_ig','f1_tg','f1_web','f1_dir','w10_ref','w10_brag','w10_du','w10_lnk','w10_ig','w10_tg','w10_web','w10_dir','r1_ref','r1_brag','r1_du','r1_lnk','r1_ig','r1_tg','r1_web','r1_dir','r7_ref','r7_brag','r7_du','r7_lnk','r7_ig','r7_tg','r7_web','r7_dir'])
        && okInc('v')
        && okInc('nd')
        && okInc('rg')
        && okInc('f1')
        && okInc('w10')
        && okInc('r1')
        && okInc('r7')
        && okInc('nd_ref')
        && okInc('nd_brag')
        && okInc('nd_du')
        && okInc('nd_lnk')
        && okInc('nd_ig')
        && okInc('nd_tg')
        && okInc('nd_web')
        && okInc('nd_dir')
        && okInc('rg_ref')
        && okInc('rg_brag')
        && okInc('rg_du')
        && okInc('rg_lnk')
        && okInc('rg_ig')
        && okInc('rg_tg')
        && okInc('rg_web')
        && okInc('rg_dir')
        && okInc('f1_ref')
        && okInc('f1_brag')
        && okInc('f1_du')
        && okInc('f1_lnk')
        && okInc('f1_ig')
        && okInc('f1_tg')
        && okInc('f1_web')
        && okInc('f1_dir')
        && okInc('w10_ref')
        && okInc('w10_brag')
        && okInc('w10_du')
        && okInc('w10_lnk')
        && okInc('w10_ig')
        && okInc('w10_tg')
        && okInc('w10_web')
        && okInc('w10_dir')
        && okInc('r1_ref')
        && okInc('r1_brag')
        && okInc('r1_du')
        && okInc('r1_lnk')
        && okInc('r1_ig')
        && okInc('r1_tg')
        && okInc('r1_web')
        && okInc('r1_dir')
        && okInc('r7_ref')
        && okInc('r7_brag')
        && okInc('r7_du')
        && okInc('r7_lnk')
        && okInc('r7_ig')
        && okInc('r7_tg')
        && okInc('r7_web')
        && okInc('r7_dir');
    }

    // th: ustozning "rahmat"lari (o'quvchi kaliti hash'i bo'yicha).
    match /th/{id} {
      allow get: if isHex(id, 24);
      allow create, update: if isHex(id, 24)
        && request.resource.data.keys().hasOnly(['l','t'])
        && str(request.resource.data.l, 20000)
        && request.resource.data.t is int;
    }
  }
}
